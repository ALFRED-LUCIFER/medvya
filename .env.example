# Variable NAMES for local development only. Real values for cloud environments live in Key Vault.
POSTGRES_PASSWORD=
# Demo request notification (MDV-P1-003); Development defaults send to the local mail sink (localhost:2525).
Leads__Email__To=
Leads__Email__SmtpHost=
Leads__Email__SmtpPort=
# Outgoing email (SendGrid SMTP relay in the cloud; smtp4dev locally needs none of these).
# Email__Smtp__Password is the SendGrid API key: Key Vault only, never in a file.
Email__Smtp__Password=
Email__Smtp__From=
Invitations__LinkBaseUrl=
# Reminders and confirmations (MDV-P1-032/033). Jobs__Enabled=true starts the Hangfire server (Development: also set Notifications__DevAllowAllConsent=true until the consent module exists).
Jobs__Enabled=
Jobs__DashboardUsers__0=
# HMAC secret that signs delivery receipts: Key Vault only.
Notifications__ReceiptSecret=
Notifications__Sms__DefaultSender=
Notifications__Sms__DltTemplateIds__Confirmation.en=
