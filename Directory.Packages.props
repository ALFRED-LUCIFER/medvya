<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion here override a vulnerable transitive dependency. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every NuGet version lives here; project files reference packages without versions. -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.10.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <!-- MDV-P1-005 (#211): decode and re-encode uploaded images so hidden payloads never reach storage. MIT; native assets for Linux App Service and CI. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- MDV-P2-017: the QR code that verifies a printed prescription. MIT, managed, no dependencies; a hand-written encoder (Reed-Solomon, masks) would need its own decoder to test. -->
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <!-- Every server PDF (signed note, prescription; ADR-018): shaped Hindi, Tamil and Arabic with embedded Noto fonts, native Skia shipped in the package (linux-x64 App Service). Community licence, see the ADR. -->
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <!-- Test only: reads the text and pages back out of the server PDFs. Apache-2.0. -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- Wraps per-tenant data keys with a Key Vault key (MDV-P0-035); already a transitive of the Always Encrypted provider. -->
    <PackageVersion Include="Azure.Security.KeyVault.Keys" Version="4.10.2" />
    <!-- Email through Azure Communication Services (Email:Provider=Acs), passwordless with the app identity. -->
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
        <!-- Transitive via Hangfire.Core 1.8; 11.0.1 has GHSA-5crp-9r3c-p9vr. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Transitive via Fido2 in the test projects; 9.0.0 has GHSA-vmv3-wvjp-wqpj (CVE-2026-118747), fixed in 10.0.15. -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.15" />
    <!-- Jobs on PostgreSQL (ADR-012): reminders and the outbox publisher, MDV-P1-032. -->
    <!-- WebAuthn security keys for the platform console (MDV-P5-040): the attestation and assertion checks are not ours to hand-roll. -->
    <PackageVersion Include="Fido2" Version="4.3.2" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- Tests only: a real SignalR client against the test host (board hub authorisation and delivery, MDV-P1-029). -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>