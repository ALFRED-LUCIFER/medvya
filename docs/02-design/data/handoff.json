  },
  {
   "n": "DOC_SEQUENCE",
   "cols": "id, tenant_id, country, doc_type (receipt|invoice|credit|advance), fin_year, prefix, next_no",
   "by": "P-09"
  },
  {
   "n": "PAYMENT_SPLIT",
   "cols": "id, invoice_id, method, amount_minor, provider_ref, state, confirmed_at",
