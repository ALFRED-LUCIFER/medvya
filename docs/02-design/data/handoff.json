 "a11y": [
  {
   "t": "Text contrast ≥ 4.5:1 (tokens verified in Foundations)",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "Status never by colour alone: icon + label on every chip",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "Visible 2px focus ring on all interactive elements",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "Full keyboard path: consent → record → review → sign",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "Touch targets ≥ 44px (48px in portal)",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "Form errors announced via aria-live and shown under the field",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "Tables have header cells and readable at 200 % zoom",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "prefers-reduced-motion stops waveform and progress animations",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "Print styles for Rx, visit summary and signed note",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  },
  {
   "t": "RTL layout verified for Arabic name and UAE portal",
   "icon": "check_box_outline_blank",
   "c": "#8296A8"
  }
 ],
 "erd": [
  {
   "n": "PATIENT_RELATIONSHIP",
