  },
  {
   "n": "PACKAGE_ENROLMENT / REDEMPTION",
   "cols": "id, patient_id, package_id, paid_minor, sessions_total, valid_to · id, enrolment_id, encounter_id, at",
   "by": "P-11"
  },
  {
   "n": "DUE / STATEMENT",
   "cols": "id, patient_id, invoice_id, amount_minor, due_at, state · id, patient_id, period, pdf_ref",
   "by": "P-12"
  },
  {
   "n": "CASH_SESSION",
   "cols": "id, facility_id, user_id, opened_at, float_minor, counted_json, variance_minor, reason, closed_at",
