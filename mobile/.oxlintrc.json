{
  "$schema": "../web/clinic/node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/jsx-no-literals": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          { "group": ["@medvya/ui", "@medvya/ui/*", "react-dom", "radix-ui", "@radix-ui/*", "lucide-react"], "message": "Native apps never import web UI (ADR-013); use React Native and packages/ui-native." },
          { "group": ["**/web/**", "@medvya/mobile-*"], "message": "An app never imports another app (ADR-013); share code through packages/." }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["*/src/features/*/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "group": ["@medvya/ui", "@medvya/ui/*", "react-dom", "radix-ui", "@radix-ui/*", "lucide-react"], "message": "Native apps never import web UI (ADR-013)." },
              { "group": ["**/services/*", "**/services"], "message": "Components are presentational: get data and actions from a controller hook via props (docs/03-architecture/frontend-architecture.md)." },
              { "group": ["**/hooks/*"], "message": "Components receive the controller's view model as props; app/ wires hooks to components." },
              { "group": ["@tanstack/*", "expo-secure-store", "expo-sqlite"], "message": "Server state and storage belong in controller hooks and services, not components." }
            ]
          }
        ],
        "no-restricted-globals": ["error", { "name": "fetch", "message": "I/O lives in services/." }, { "name": "XMLHttpRequest", "message": "I/O lives in services/." }]
      }
    },
    {
      "files": ["*/src/features/*/hooks/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["**/components/*", "react-native", "@medvya/ui", "@medvya/ui-native"], "message": "Controller hooks return data and handlers, never UI." }] }
        ],
        "no-restricted-globals": ["error", { "name": "fetch", "message": "Call a service from the hook; services own I/O." }]
      }
    },
    {
      "files": ["*/src/features/*/services/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["react", "**/hooks/*", "**/components/*", "@medvya/ui", "@medvya/ui-native"], "message": "Services are plain TypeScript I/O: no React, no UI (React Native platform APIs such as AppState and Linking are fine)." }] }
        ]
      }
    },
    {
      "files": ["*/src/features/*/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["react", "react-native", "expo", "expo-*", "**/hooks/*", "**/components/*", "**/services/*", "@medvya/ui", "@medvya/ui-native"], "message": "Domain is pure: types and rules only." }] }
        ],
        "no-restricted-globals": ["error", "fetch", "XMLHttpRequest"]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "react/jsx-no-literals": "off" }
    }
  ]
}
