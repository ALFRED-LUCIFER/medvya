{
  "expo": {
    "name": "Medvya Clinic",
    "slug": "medvya-clinician",
    "scheme": "medvya-clinician",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.medvya.clinician",
      "supportsTablet": true
    },
    "android": {
      "package": "com.medvya.clinician"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "hi",
            "ar"
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Medvya uses Face ID to unlock the app and keep records private."
        }
      ]
    ]
  }
}
