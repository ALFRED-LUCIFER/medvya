{
  "expo": {
    "name": "Medvya Clinic",
    "slug": "medvya-clinician",
    "scheme": "medvya-clinician",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.medvya.clinician",
      "supportsTablet": true
    },
    "android": {
      "package": "com.medvya.clinician",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "en",
            "hi",
            "ar"
          ]
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Medvya uses Face ID to unlock the app and keep records private."
        }
      ]
    ]
  }
}
