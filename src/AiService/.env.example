# Medvya AI service configuration (src/AiService). Copy to src/AiService/.env (git-ignored) and fill in. Never commit .env.
# Names only (AGENTS.md 1.7). Values live in user secrets locally and Key Vault in Azure.

# --- Local Postgres container (docker/01-roles.sh) ---------------------------------
# POSTGRES_PASSWORD: superuser/owner password of the dev container. Pick any long random value.
POSTGRES_PASSWORD=
# MEDVYA_AI_APP_PASSWORD: password of the least-privilege role "medvya_ai_app" the API uses.
MEDVYA_AI_APP_PASSWORD=

# --- Database ---------------------------------------------------------------------------
# DATABASE_URL: runtime connection, role medvya_ai_app (non-owner, RLS enforced). asyncpg driver.
# Azure portal: Azure Database for PostgreSQL flexible server > Connect (host, port); user and
# password are the ones you created for the app role.
DATABASE_URL=
# DATABASE_URL_MIGRATE: owner connection used ONLY by Alembic (alembic upgrade head).
# Azure portal: same server, admin login from Overview > Server admin login name.
DATABASE_URL_MIGRATE=
# Integration tests (database name must end in _test; the suite drops and recreates its schema).
# Both unset or unreachable: integration tests are skipped, never failed.
MEDVYA_AI_TEST_DATABASE_URL=
MEDVYA_AI_TEST_DATABASE_URL_MIGRATE=

# --- Blob storage (encrypted audio chunks) ----------------------------------------------
# AZURE_STORAGE_CONNECTION_STRING: Azure portal > Storage account > Security + networking >
# Access keys > Connection string. For local Azurite use the development connection string
# published in the Azurite documentation (https://learn.microsoft.com/azure/storage/common/storage-use-azurite).
AZURE_STORAGE_CONNECTION_STRING=
# BLOB_CONTAINER: container name, created on first use. Any lowercase name.
BLOB_CONTAINER=

# --- Azure Speech (fast transcription) ---------------------------------------------------
# SPEECH_REGION: Azure portal > Speech service > Overview > Location, e.g. centralindia.
SPEECH_REGION=
# SPEECH_KEY: Speech service > Keys and Endpoint > KEY 1.
SPEECH_KEY=
# SPEECH_ENDPOINT: Speech service > Keys and Endpoint > Endpoint. Leave empty to derive from region.
SPEECH_ENDPOINT=
# SPEECH_API_VERSION: fast transcription REST api-version, confirm on Microsoft Learn.
SPEECH_API_VERSION=
# SPEECH_LOCALES: candidate locales, comma separated. hi-IN and en-IN cover Hinglish.
SPEECH_LOCALES=
# SPEECH_MAX_SPEAKERS: diarization upper bound (doctor, patient, one companion).
SPEECH_MAX_SPEAKERS=

# --- Azure AI Foundry (LLM: normalise + extract) -----------------------------------------
# FOUNDRY_ENDPOINT: Foundry portal > your project/resource > Overview > Azure OpenAI endpoint,
# form https://<resource>.openai.azure.com/openai/v1/
FOUNDRY_ENDPOINT=
# FOUNDRY_API_KEY: same page, Keys and Endpoint > KEY 1.
FOUNDRY_API_KEY=
# Deployment names: Foundry portal > Deployments > the name you gave the model deployment.
FOUNDRY_DEPLOYMENT_EXTRACT=
FOUNDRY_DEPLOYMENT_NORMALISE=
# PROCESSING_ENDPOINT_HOSTS: comma separated exact hosts this country may use (AGENTS.md 1.6), e.g. the
# Central India Speech host and the Indian Foundry resource host. The worker refuses to start with a real
# provider whose endpoint host is not listed.
PROCESSING_ENDPOINT_HOSTS=

# --- Providers -----------------------------------------------------------------------------
# TRANSCRIPTION_PROVIDER: azure_fast | fake. Use fake for local work without Azure.
TRANSCRIPTION_PROVIDER=
# LLM_PROVIDER: foundry | fake. Use fake for local work without Azure.
LLM_PROVIDER=

# --- Environment and authentication ---------------------------------------------------------
# ENVIRONMENT: development | test | production. Only development may use AUTH_MODE=disabled and serves /docs.
ENVIRONMENT=
# AUTH_MODE: service | entra | disabled.
#   service (default) = Medvya's Host.Api calls with its managed-identity token; X-Clinic-Id, X-User-Id and
#   X-User-Role are trusted only under that token. entra = a per-user token whose oid matches
#   app_user.external_subject (`python -m medvya_ai.seed --provision --email ... --subject <oid>`).
#   disabled = no token, X-Clinic-Id required: ENVIRONMENT=development only, never with patient data.
AUTH_MODE=
# AUTH_ISSUER: Entra admin center > App registrations > your API app > Endpoints; v2.0 issuer
# https://login.microsoftonline.com/<directory-tenant-id>/v2.0
AUTH_ISSUER=
# AUTH_AUDIENCE: the API app registration's Application ID URI (api://<client-id>) or client id.
AUTH_AUDIENCE=
# AUTH_JWKS_URL: derived from an Entra issuer when empty; set for any other OIDC provider.
AUTH_JWKS_URL=
# AUTH_ALLOWED_CLIENT_IDS (service mode): comma separated client ids (token azp/appid) allowed to call,
# i.e. Host.Api's managed identity. Entra admin center > Enterprise applications > the identity > Application ID.
AUTH_ALLOWED_CLIENT_IDS=
# AUTH_REQUIRED_ROLE (service mode): the app role defined on this API's app registration and assigned to
# Host.Api's managed identity (App registrations > App roles).
AUTH_REQUIRED_ROLE=

# --- Retention (per-clinic overrides live in the retention_policy table) ------------------
# Delete audio this many hours after a note is approved.
RETENTION_AUDIO_AFTER_APPROVAL_HOURS=
# Delete audio of abandoned drafts after this many days.
RETENTION_DRAFT_AUDIO_DAYS=
# Purge a session's working data (transcript, facts, draft, participant names) this many days after it
# finished (default 30, proposed in ADR-021).
RETENTION_SESSION_DAYS=

# --- Crypto --------------------------------------------------------------------------------
# ENCRYPTION_MASTER_KEY: base64 of 32 random bytes; wraps each session's data key.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Production: store in Azure Key Vault (Key Vault > Secrets) and inject at deploy time. Losing it
# makes stored audio unrecoverable; rotating it needs a re-wrap job (follow-up).
ENCRYPTION_MASTER_KEY=

# --- HTTP / recording tuning -------------------------------------------------------------
# MAX_CHUNK_BYTES: reject chunk uploads above this size (413). 10 s of Opus is about 20 KB.
MAX_CHUNK_BYTES=
# MAX_SESSION_CHUNKS / MAX_SESSION_BYTES: per-session caps on stored chunks and audio bytes (413).
# Soft caps: two concurrent uploads can overshoot by one chunk each.
MAX_SESSION_CHUNKS=
MAX_SESSION_BYTES=
# SEGMENT_MAX_MS: client rotates the recorder segment after this long (default 60 min).
SEGMENT_MAX_MS=
# WORKER_POLL_SECONDS: how often the job worker polls the queue.
WORKER_POLL_SECONDS=

# --- Telemetry ---------------------------------------------------------------------------------
# APPLICATIONINSIGHTS_CONNECTION_STRING: Azure portal > Application Insights > Overview >
# Connection String. Empty disables Azure Monitor export.
APPLICATIONINSIGHTS_CONNECTION_STRING=

