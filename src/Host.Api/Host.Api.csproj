<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Modules\Identity\Medvya.Identity.Api\Medvya.Identity.Api.csproj" />
    <ProjectReference Include="..\Modules\Identity\Medvya.Identity.Infrastructure\Medvya.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\Medvya.Tenancy.Api\Medvya.Tenancy.Api.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\Medvya.Tenancy.Infrastructure\Medvya.Tenancy.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Audit\Medvya.Audit.Api\Medvya.Audit.Api.csproj" />
    <ProjectReference Include="..\Modules\Audit\Medvya.Audit.Infrastructure\Medvya.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Medvya.BuildingBlocks.Domain\Medvya.BuildingBlocks.Domain.csproj" />
