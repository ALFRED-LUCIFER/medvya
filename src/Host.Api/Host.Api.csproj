<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Modules\Identity\Medvya.Identity.Api\Medvya.Identity.Api.csproj" />
    <ProjectReference Include="..\Modules\Identity\Medvya.Identity.Infrastructure\Medvya.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\Medvya.Tenancy.Api\Medvya.Tenancy.Api.csproj" />
    <ProjectReference Include="..\Modules\Tenancy\Medvya.Tenancy.Infrastructure\Medvya.Tenancy.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Audit\Medvya.Audit.Api\Medvya.Audit.Api.csproj" />
    <ProjectReference Include="..\Modules\Audit\Medvya.Audit.Infrastructure\Medvya.Audit.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Patients\Medvya.Patients.Api\Medvya.Patients.Api.csproj" />
    <ProjectReference Include="..\Modules\Patients\Medvya.Patients.Infrastructure\Medvya.Patients.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Scheduling\Medvya.Scheduling.Api\Medvya.Scheduling.Api.csproj" />
    <ProjectReference Include="..\Modules\Scheduling\Medvya.Scheduling.Infrastructure\Medvya.Scheduling.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Leads\Medvya.Leads.Infrastructure\Medvya.Leads.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Medvya.Notifications.Api\Medvya.Notifications.Api.csproj" />
    <ProjectReference Include="..\Modules\Encounters\Medvya.Encounters.Api\Medvya.Encounters.Api.csproj" />
    <ProjectReference Include="..\Modules\Encounters\Medvya.Encounters.Infrastructure\Medvya.Encounters.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Prescribing\Medvya.Prescribing.Api\Medvya.Prescribing.Api.csproj" />
    <ProjectReference Include="..\Modules\Prescribing\Medvya.Prescribing.Infrastructure\Medvya.Prescribing.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Medvya.Notifications.Infrastructure\Medvya.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="..\BuildingBlocks\Medvya.BuildingBlocks.Domain\Medvya.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <!-- Public site reuses the shared design tokens and message catalogues instead of copying them (MDV-P1-001). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packages\tokens\src\tokens.css" LogicalName="PublicSite.tokens.css" />
    <EmbeddedResource Include="..\..\packages\i18n\messages\*.json" LogicalName="PublicSite.messages.%(Filename).json" />
    <EmbeddedResource Include="PublicSite\site.css" LogicalName="PublicSite.site.css" />
    <!-- Trust centre lists: content read at runtime so they can change without a redeploy (MDV-P1-003). -->
    <Content Update="PublicSite\trust-centre.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="PublicSite\pricing.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <!-- `pnpm export:openapi` builds with ExportOpenApi=true: the document is written to packages/api-client/openapi.json (MDV-P0-040). -->
  <PropertyGroup Condition="'$(ExportOpenApi)' == 'true'">
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\packages\api-client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

</Project>
