@page
@model TrustModel
@{
    var p = Model;
    ViewData["Title"] = $"{p.T("site.trust.title")} · {p.T("app.name")}";
    ViewData["Description"] = p.T("site.trust.footer");
    // Decorative line icons for the six designed blocks (F-07).
    var blocks = new (string Key, string Icon)[]
    {
        ("residency", "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"),
        ("consent", "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21a7 7 0 0 1 12-5M15 18l2 2 5-5"),
        ("ai", "M12 3l2 5 5 2-5 2-2 5-2-5-5-2 5-2zM19 15l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"),
        ("retention", "M3 7h18v4H3zM5 11v9h14v-9M10 15h4"),
        ("audit", "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4"),
        ("subProcessors", "M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM17 11a3 3 0 1 0 0-6M3 20a6 6 0 0 1 12 0M15 14a6 6 0 0 1 6 6"),
    };
    var notInEffect = p.T("site.trust.notYetInEffect");
}
<section class="trust-hero" aria-labelledby="trust-title">
    <div>
        <p class="eyebrow">@p.T("site.nav.trust")</p>
        <h1 id="trust-title">@p.T("site.trust.heading")</h1>
        <p class="lede">@p.T("site.trust.lead")</p>
    </div>
    <span class="trust-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="52" height="52" focusable="false"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12h6v5H9zM10.5 12v-2a1.5 1.5 0 0 1 3 0v2" /></svg></span>
</section>
<div class="trust">
    <section aria-labelledby="controls-title">
        <h2 id="controls-title">@p.T("site.trust.controls.title")</h2>
        <ul class="trust-cards">
            @foreach (var (key, icon) in blocks)
            {
                <li>
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="@icon" /></svg>
                    <h3>@p.T($"site.trust.{key}.title")</h3>
                    <p>@p.T($"site.trust.{key}.body")</p>
                </li>
            }
        </ul>
        <p class="note">@p.T("site.trust.footer")</p>
    </section>

    @* Statuses come only from trust-centre.json; the header says plainly that none is a certification (MDV-P1-058). *@
    <section class="compliance" aria-labelledby="compliance-title">
        <div class="compliance-head">
            <h2 id="compliance-title">@p.T("site.trust.compliance.title")</h2>
            <p>@p.T("site.trust.compliance.note")</p>
        </div>
        <ul>
            @foreach (var item in p.Lists.Compliance)
            {
                // A typo in the editable file must not take the page down; it shows the weaker claim instead.
                var status = item.Status == "inProgress" ? "inProgress" : "planned";
                <li>
                    <strong>@p.Localized(item.Name)</strong>
                    <span>@p.Localized(item.Detail)</span>
                    <span class="status status-@status">@p.T($"site.trust.status.{status}")</span>
                </li>
            }
        </ul>
    </section>

    <section aria-labelledby="policies-title">
        <h2 id="policies-title">@p.T("site.trust.policies.title")</h2>
        <ul class="entries">
            @foreach (var policy in p.Lists.Policies)
            {
                <li>
                    <h3>@p.Localized(policy.Name)</h3>
                    <dl>
                        <dt>@p.T("site.trust.version")</dt><dd>@policy.Version</dd>
                        <dt>@p.T("site.trust.effective")</dt><dd>@(policy.Effective is { } d ? p.Date(d) : notInEffect)</dd>
                    </dl>
                </li>
            }
        </ul>
    </section>

    <section aria-labelledby="subprocessors-title">
        <h2 id="subprocessors-title">@p.T("site.trust.subProcessors.title")</h2>
        <ul class="entries">
            @foreach (var sub in p.Lists.SubProcessors)
            {
                <li>
                    <h3>@sub.Name</h3>
                    <dl>
                        <dt>@p.T("site.trust.purpose")</dt><dd>@p.Localized(sub.Purpose)</dd>
                        <dt>@p.T("site.trust.region")</dt><dd>@(sub.Region.TryGetValue(p.Region, out var r) ? r : p.T("site.trust.regionPending"))</dd>
                        <dt>@p.T("site.trust.effective")</dt><dd>@(sub.Effective is { } d ? p.Date(d) : notInEffect)</dd>
                    </dl>
                </li>
            }
        </ul>
        @if (p.Lists.Updated is { } updated)
        {
            <p class="note">@p.T("site.trust.contentVersion", new Dictionary<string, string> { ["version"] = p.Lists.Version, ["date"] = p.Date(updated) })</p>
        }
    </section>

    @* The form moved to /demo (MDV-P1-057); old /trust#demo links land here, one link away from it. *@
    <section id="demo" class="trust-demo" aria-labelledby="demo-title">
        <h2 id="demo-title">@p.T("site.trust.demo.title")</h2>
        <p>@p.T("site.trust.demo.body")</p>
        <a class="button button-primary" href="@p.Href(PublicSite.Demo)">@p.T("site.trust.demo.link")</a>
    </section>
</div>
