{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc",
    "import"
  ],
  "jsPlugins": [
    "../../tools/oxlint-plugin/medvya-ui.mjs"
  ],
  "rules": {
    "medvya-ui/no-height-patch": "error",
    "medvya-ui/compact-table": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/jsx-no-literals": "error"
  },
  "overrides": [
    {
      "files": [
        "src/features/**"
      ],
      "rules": {
        "react/forbid-elements": [
          "error",
          {
            "forbid": [
              { "element": "table", "message": "Use Table from @medvya/ui (MDV-P0-030; docs/03-architecture/frontend-architecture.md, Tables)." },
              { "element": "thead", "message": "Use TableHeader from @medvya/ui." },
              { "element": "tbody", "message": "Use TableBody from @medvya/ui." },
              { "element": "tfoot", "message": "Use TableFooter from @medvya/ui." },
              { "element": "tr", "message": "Use TableRow from @medvya/ui." },
              { "element": "th", "message": "Use TableHead from @medvya/ui." },
              { "element": "td", "message": "Use TableCell from @medvya/ui." },
              { "element": "caption", "message": "Use TableCaption from @medvya/ui." }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/components/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/services/*",
                  "**/services"
                ],
                "message": "Components are presentational: get data and actions from a controller hook via props (docs/03-architecture/frontend-architecture.md)."
              },
              {
                "group": [
                  "**/hooks/*"
                ],
                "message": "Components receive the controller's view model as props; app/ wires hooks to components."
              },
              {
                "group": [
                  "@tanstack/*"
                ],
                "message": "Server state belongs in controller hooks, not components."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "I/O lives in services/."
          },
          {
            "name": "localStorage",
            "message": "I/O lives in services/."
          },
          {
            "name": "sessionStorage",
            "message": "I/O lives in services/."
          },
          {
            "name": "XMLHttpRequest",
            "message": "I/O lives in services/."
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/hooks/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/components/*",
                  "@medvya/ui",
                  "lucide-react"
                ],
                "message": "Controller hooks return data and handlers, never UI."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "Call a service from the hook; services own I/O."
          },
          {
            "name": "localStorage",
            "message": "Call a service from the hook; services own I/O."
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/services/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "**/hooks/*",
                  "**/components/*",
                  "@medvya/ui",
                  "lucide-react"
                ],
                "message": "Services are plain TypeScript I/O: no React, no UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/*/domain/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "**/hooks/*",
                  "**/components/*",
                  "**/services/*",
                  "@medvya/ui",
                  "lucide-react"
                ],
                "message": "Domain is pure: types and rules only."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          "fetch",
          "localStorage",
          "sessionStorage",
          "window",
          "document"
        ]
      }
    },
    {
      "files": [
        "src/dev/**"
      ],
      "rules": {
        "react/jsx-no-literals": "off"
      }
    }
  ]
}
